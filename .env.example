# ---------------------------------------------------------------------------
# Kyros web/API — example environment
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and must NEVER
# be committed. Rotate any secret that has ever touched a commit.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
# Public base URL of this deployment (used in links inside notifications).
APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# PostgreSQL. Use a dedicated least-privilege role, not the superuser.
DATABASE_URL=postgresql://kyros:kyros@localhost:5432/kyros?schema=public
# Optional direct (non-pooled) URL for migrations when running behind pgbouncer.
DIRECT_DATABASE_URL=postgresql://kyros:kyros@localhost:5432/kyros?schema=public

# --- Auth -------------------------------------------------------------------
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-me-with-a-long-random-value-at-least-32-chars
ACCESS_TOKEN_TTL=900          # seconds (15 min)
REFRESH_TOKEN_TTL=2592000     # seconds (30 days)

# --- OTP --------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
# When true, OTPs are logged to the server console instead of being sent.
# MUST be false in production.
OTP_DEV_MODE=true
# SMS provider (India). Leave blank while OTP_DEV_MODE=true.
SMS_PROVIDER=                 # msg91 | twilio | (blank)
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=

# --- Payments (Razorpay / UPI) ----------------------------------------------
# Key ID is publishable; the SECRET and WEBHOOK_SECRET are not — never expose
# them to the client bundle and never commit them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR
# Platform commission on turf bookings only, in basis points (e.g. 1000 = 10%).
PLATFORM_COMMISSION_BPS=1000

# --- DPDP / parent verification ---------------------------------------------
# Pluggable verifier. `mock` is for local dev only — env() refuses to boot
# production with it, because it would ship a consent mechanism that verifies
# nothing.
CONSENT_VERIFIER=mock         # mock | digilocker

# DigiLocker partner application credentials. Obtained by registering at
# https://partners.digitallocker.gov.in — a commercial onboarding step, not a
# self-service one. The REDIRECT_URI must match the value registered there
# EXACTLY, including scheme and trailing path.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:3000/api/v1/consent/digilocker/callback

# Endpoints are overridable so the partner sandbox can be targeted without a
# code change. Leave unset to use production.
# DIGILOCKER_AUTHORIZE_URL=https://api.digitallocker.gov.in/public/oauth2/1/authorize
# DIGILOCKER_TOKEN_URL=https://api.digitallocker.gov.in/public/oauth2/1/token
DIGILOCKER_TIMEOUT_MS=15000

# Deep link scheme the consent callback bounces the parent back into the app
# with. Must match `expo.scheme` in kyros-app/app.json.
APP_DEEP_LINK_SCHEME=kyros

# --- Object storage (photos, logos, venue images) ---------------------------
STORAGE_PROVIDER=local        # local | s3
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Push notifications ------------------------------------------------------
EXPO_ACCESS_TOKEN=

# --- Observability ----------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
